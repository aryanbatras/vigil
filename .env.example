# ---------------------------------------------------------------------------
# Vigil / environment
# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local` or any file containing a secret key.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, Open Graph metadata and absolute
# links. Local: http://localhost:3000. Production: your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk — https://dashboard.clerk.com
# Both keys come from the same application. Use the development instance
# first; a production deployment needs a production instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk redirects. These are read by Clerk middleware / components.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/security

# Supabase — https://supabase.com/dashboard
# The app talks to Supabase only from the server. Do not add NEXT_PUBLIC_ to
# these names and do not expose the service-role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_the_service_role_key

# Clerk webhook signing secret — optional, enables live MFA lifecycle rows.
# Clerk Dashboard → Configure → Webhooks → add endpoint:
#   https://your-domain.tld/api/webhooks/clerk
# Subscribe to: user.created, user.updated
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
